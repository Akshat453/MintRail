{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "timeout": 660,
        "failClosed": true,
        "command": "PATH=\"$PATH:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin\" agw hook cursor beforeShellExecution"
      }
    ],
    "beforeMCPExecution": [
      {
        "timeout": 660,
        "failClosed": true,
        "command": "PATH=\"$PATH:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin\" agw hook cursor beforeMCPExecution"
      }
    ],
    "beforeReadFile": [
      {
        "timeout": 660,
        "failClosed": true,
        "command": "PATH=\"$PATH:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin\" agw hook cursor beforeReadFile"
      }
    ],
    "preToolUse": [
      {
        "timeout": 660,
        "failClosed": true,
        "command": "PATH=\"$PATH:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin\" agw hook cursor preToolUse",
        "matcher": "Write|Delete|Grep|Task|MCP:.*"
      }
    ],
    "postToolUse": [
      {
        "command": "PATH=\"$PATH:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin\" agw hook cursor postToolUse"
      }
    ],
    "afterShellExecution": [
      {
        "command": "PATH=\"$PATH:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin\" agw hook cursor afterShellExecution"
      }
    ],
    "afterMCPExecution": [
      {
        "command": "PATH=\"$PATH:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin\" agw hook cursor afterMCPExecution"
      }
    ],
    "sessionStart": [
      {
        "command": "PATH=\"$PATH:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin\" agw hook cursor sessionStart"
      }
    ],
    "sessionEnd": [
      {
        "command": "PATH=\"$PATH:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin\" agw hook cursor sessionEnd"
      }
    ]
  }
}
