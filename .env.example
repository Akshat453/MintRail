# Copy to .env for local development. Never commit real values.
MINTRAIL_ENVIRONMENT=dev
MINTRAIL_DATABASE_URL=postgres://mintrail:mintrail@localhost:5432/mintrail

# Secrets — placeholders only. Staging/production refuse to boot with these values.
MINTRAIL_API_KEY_PEPPER=change-me-api-key-pepper
# base64 of 32 bytes; encrypts API request-signing keys at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MINTRAIL_SECRETS_KEY=ZGV2LW9ubHktbm90LWEtc2VjcmV0LWtleS0zMmJ5dGU=
MINTRAIL_JUNCTION_API_KEY=change-me-junction-api-key
MINTRAIL_JUNCTION_CALLBACK_SECRET=change-me-junction-callback-secret

# First Railyard admin, created by the migrate step (local only).
MINTRAIL_BOOTSTRAP_ADMIN_EMAIL=admin@mintrail.example
MINTRAIL_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# Junction (bank simulator). Scale < 1 speeds up simulated bank latency (0 = instant).
MINTRAIL_JUNCTION_URL=http://localhost:8100
MINTRAIL_JUNCTION_CALLBACK_URL=http://localhost:8000/internal/junction/v1/callbacks
MINTRAIL_JUNCTION_SEED=20221
MINTRAIL_JUNCTION_LATENCY_SCALE=0.2

# Signal (webhooks) and Depot (settlements) service tokens — placeholders only.
MINTRAIL_SIGNAL_API_KEY=change-me-signal-api-key
MINTRAIL_DEPOT_API_KEY=change-me-depot-api-key
# Webhook retries: base 30s doubling to 6h, 10 attempts. Scale 0 = retry immediately (tests only).
MINTRAIL_SIGNAL_MAX_ATTEMPTS=10
MINTRAIL_SIGNAL_BACKOFF_SCALE=1
# Settlements: IST cutoff hour (0 = midnight) and simulated bank-credit delay.
MINTRAIL_SETTLEMENT_CUTOFF_HOUR_IST=0
MINTRAIL_SETTLEMENT_BANK_DELAY_S=60

# Platform HTTP hardening
MINTRAIL_CORS_ALLOWED_ORIGINS=
MINTRAIL_MAX_BODY_BYTES=1048576

MINTRAIL_LOG_LEVEL=info
MINTRAIL_LOG_JSON=true
MINTRAIL_PUBLIC_BASE_URL=https://api.mintrail.example

# Host ports for docker compose (change if they are taken locally).
# If you change MINTRAIL_PG_PORT, update the port in MINTRAIL_DATABASE_URL too.
MINTRAIL_PG_PORT=5432
MINTRAIL_API_PORT=8000
MINTRAIL_JUNCTION_PORT=8100
MINTRAIL_SIGNAL_PORT=8200
MINTRAIL_DEPOT_PORT=8300
MINTRAIL_DASHBOARD_PORT=3000
MINTRAIL_RAILYARD_PORT=3100
MINTRAIL_DEMO_API_URL=http://localhost:8000

# Postgres container
POSTGRES_USER=mintrail
POSTGRES_PASSWORD=mintrail
POSTGRES_DB=mintrail
