{
  "name": "@mintrail/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Platform \u2014 MintRail's public HTTP API, Railyard internal API and payments worker",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "development": "./src/testing.ts",
      "types": "./src/testing.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main-server.js",
    "worker": "node dist/main-worker.js"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@mintrail/conductor": "workspace:*",
    "@mintrail/ledger": "workspace:*",
    "@mintrail/shared": "workspace:*",
    "cors": "2.8.6",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "zod": "4.6.7",
    "@mintrail/signal": "workspace:*",
    "multer": "2.5.0"
  },
  "devDependencies": {
    "@mintrail/junction": "workspace:*",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "fast-check": "4.10.2",
    "supertest": "7.3.2",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "@types/multer": "2.3.0"
  }
}
