# syntax=docker/dockerfile:1.7
# MintRail Next.js apps (dashboard, railyard): docker build --build-arg APP=dashboard …
FROM node:22.22.2-slim AS build
ARG APP
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=true NEXT_TELEMETRY_DISABLED=1
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY ledger/package.json ledger/
COPY conductor/package.json conductor/
COPY junction/package.json junction/
COPY api/package.json api/
COPY depot/package.json depot/
COPY signal/package.json signal/
COPY sdk-node/package.json sdk-node/
COPY packages/web/package.json packages/web/
COPY dashboard/package.json dashboard/
COPY railyard/package.json railyard/
COPY tests/parity/package.json tests/parity/
COPY tools/eslint-plugin-mintrail tools/eslint-plugin-mintrail
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile --filter "@mintrail/${APP}..."
COPY sdk-node sdk-node
COPY packages/web packages/web
COPY ${APP} ${APP}
RUN pnpm --filter @mintrail/node build && pnpm --filter "@mintrail/${APP}" build

FROM node:22.22.2-slim
ARG APP
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 APP=${APP}
WORKDIR /app
COPY --from=build --chown=node:node /app /app
USER node
WORKDIR /app/${APP}
CMD ["sh", "-c", "exec node_modules/.bin/next start -p ${PORT:-3000}"]
