{
  "name": "mintrail",
  "private": true,
  "description": "MintRail payments platform (fictional) \u2014 backend monorepo",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "build": "pnpm -r --filter=!@mintrail/parity run build",
    "typecheck": "pnpm -r run typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "fmt": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "coverage": "vitest run --coverage",
    "parity": "pnpm --filter @mintrail/parity run parity",
    "parity:record": "pnpm --filter @mintrail/parity run record",
    "db:generate": "pnpm build && drizzle-kit generate",
    "db:migrate": "node --conditions=development --import tsx packages/shared/src/main-migrate.ts",
    "seed": "node --conditions=development --import tsx scripts/seed.ts",
    "demo": "node --conditions=development --import tsx scripts/demo.ts",
    "demo:m2": "node --conditions=development --import tsx scripts/demo-m2.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "fast-check": "4.10.2",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "drizzle-kit": "0.31.11",
    "@testcontainers/postgresql": "12.2.1",
    "pg": "8.23.1",
    "@mintrail/shared": "workspace:*",
    "tsx": "4.23.15",
    "@mintrail/api": "workspace:*",
    "@mintrail/junction": "workspace:*",
    "@mintrail/ledger": "workspace:*",
    "@mintrail/conductor": "workspace:*",
    "eslint": "10.15.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.73.0",
    "prettier": "3.10.1",
    "eslint-plugin-mintrail": "link:./tools/eslint-plugin-mintrail",
    "@types/pg": "8.23.1",
    "drizzle-orm": "0.45.4",
    "@mintrail/depot": "workspace:*",
    "@mintrail/signal": "workspace:*",
    "@mintrail/node": "workspace:*"
  }
}
