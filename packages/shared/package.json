    "luxon": "3.7.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "fast-check": "4.10.2",
    "vitest": "5.1.0",
    "@types/luxon": "3.7.6"
  }
