{
  "name": "@mintrail/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MintRail shared building blocks: money, ids, errors, config, crypto, db, jobs, logging",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
