{
  "name": "@mintrail/signal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Signal — MintRail's webhook service: transactional outbox, signed deliveries, retries, replay",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main-server.js",
    "worker": "node dist/main-worker.js"
  },
  "dependencies": {
    "@mintrail/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "pg": "8.23.1",
    "undici": "8.12.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "fast-check": "4.10.2",
    "supertest": "7.3.2",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
